# Copy to .env next to docker-compose.yml (on the tower, never committed).
# Images: pin each one by digest after the first pull (rule 6), e.g. name:tag@sha256:...
SWARM_API_IMAGE=ghcr.io/desplega-ai/agent-swarm:2.7.10
SWARM_WORKER_IMAGE=ghcr.io/desplega-ai/agent-swarm-worker:2.7.10
AGENT_FS_IMAGE=ghcr.io/desplega-ai/agent-fs:0.18.16
MINIO_IMAGE=pgsty/minio:RELEASE.2026-08-04T00-00-00Z@sha256:b6bfe7239bfc83fb90d31612d9704d86039dd714f7904b3f1ad68f211e602372
SOCAT_IMAGE=alpine/socat

# Swarm API key shared by the API and its agents (random, local to this install).
API_KEY=
# Fixed agent IDs, so agent-task nodes can pin the worker (no lead routing).
WORKER_AGENT_ID=
LEAD_AGENT_ID=

# Factory gateway: host only (no scheme, no /v1) and a factory-public virtual key
# with max_budget (rule 2). Agent Swarm ignores a MODEL_OVERRIDE with a foreign prefix
# such as factory/, so the gateway alias goes in through ANTHROPIC_DEFAULT_*_MODEL.
GATEWAY_HOST=
SWARM_WORKER_KEY=
SWARM_LEAD_KEY=
WORKER_MODEL=factory/glm-5.3-flash

# Host directory with one copy of a task snapshot per run (no history, no hidden tests).
SPIKE_WORK_DIR=
# Host directory for the verifier service's Unix socket, mounted into the relay only.
VERIFIER_SOCKET_DIR=
