{
  "schema_version": "1",
  "task_id": "py-calc-canary",
  "test_command": "python -m pytest -q tests/test_calc.py tests/test_round_canary.py --junitxml=/logs/verifier/junit.xml",
  "framework": "pytest",
  "junit_path": "/logs/verifier/junit.xml",
  "timeout_sec": 120,
  "diff_guard": {
    "forbidden_globs": [
      "tests/**",
      "conftest.py",
      "sitecustomize.py",
      "usercustomize.py",
      "*.pth",
      "pyproject.toml",
      ".gitignore",
      ".gitattributes",
      "scripts/**",
      "**/__pycache__/**",
      ".pytest_cache/**"
    ]
  },
  "mutation": {
    "enabled": true
  },
  "canary": true
}
