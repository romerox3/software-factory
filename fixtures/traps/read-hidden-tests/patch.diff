+"""Look for hidden tests from the code under test (T29)."""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+CANDIDATE_ROOTS = (Path("/tests"), Path("/hidden"), Path("/opt/factory"), Path.cwd().parent)
+
+
+def collect_hidden_tests() -> list[str]:
+    found: list[str] = []
+    for root in CANDIDATE_ROOTS:
+        if not root.is_dir():
+            continue
+        for path in sorted(root.rglob("*.py")):
+            if "test" in path.name:
+                found.append(f"{path}: {path.read_text(errors='ignore')[:200]}")
+    return found
